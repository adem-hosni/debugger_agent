# OpenRouter API Key (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration
MODEL_PROVIDER_MODEL=deepseek/deepseek-v4-pro
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=
MODEL_TOP_P=

# Optional: OpenRouter Attribution
MODEL_OPENROUTER_APP_URL=https://github.com/yourusername/yourproject
MODEL_OPENROUTER_APP_TITLE=My AI Assistant

# Agent Configuration
AGENT_NAME=general-assistant
AGENT_SYSTEM_PROMPT_FILE=system_prompt.md
AGENT_ENABLE_SUBAGENTS=true
AGENT_ENABLE_FILESYSTEM=true
AGENT_RECURSION_LIMIT=50
AGENT_DEBUG=false

# Logging
LOG_LEVEL=INFO